---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = await Astro.glob('../pages/posts/*.md');

posts.sort((a, b) =>
  new Date(b.frontmatter.publishDate) - new Date(a.frontmatter.publishDate)
);
---

<BaseLayout>
  <section class="home-section">
    <h2>Latest Posts</h2>
    <section class="hero-post">
        <a href={posts[0].url} class="hero-card">
          <img src={posts[0].frontmatter.image || '/default.jpg'} alt={posts[0].frontmatter.title} />
          <div class="hero-text">
            <span class="category">{posts[0].frontmatter.category || 'Feature'}</span>
            <h2>{posts[0].frontmatter.title}</h2>
            <p>{posts[0].frontmatter.description}</p>
          </div>
        </a>
      </section>    
      <div class="main-grid">
        <div class="post-grid">
        {posts.map((post) => (
            <PostCard
            title={post.frontmatter.title}
            description={post.frontmatter.description}
            publishDate={post.frontmatter.publishDate}
            image={post.frontmatter.image}
            href={post.url}
            />
        ))}
        </div>
        <aside class="sidebar">
            <h3>Latest</h3>
            <ul>
              {posts.slice(1, 5).map((post) => (
                <li><a href={post.url}>{post.frontmatter.title}</a></li>
              ))}
            </ul>
          </aside>
        </div>
  </section>
</BaseLayout>

<style>
.home-section {
  padding: 2rem 1rem;
  background-color: #fafafa;
  max-width: 960px;
  margin: auto;
}

h2 {
  font-size: 2rem;
  font-weight: 700;
  border-bottom: 2px solid #990000;
  margin-bottom: 1.5rem;
  color: #990000;
}

.post-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .post-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>
