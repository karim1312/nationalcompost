---
const { title, publishDate, category } = Astro.props;
---

<html lang="en">
  <head>
    <title>{title} | National Compost</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <article>
      <header>
        <h1>{title}</h1>
        <p><em>{publishDate} · {category}</em></p>
      </header>
      <section>
        <slot />
      </section>
      <footer>
        <p><a href="/">← Back to homepage</a></p>
      </footer>
    </article>
  </body>
</html>
